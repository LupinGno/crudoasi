<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Modificar Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        html, body { height: 100%; }
        body { display: flex; align-items: center; background-color: #f8f9fa; }
    </style>
</head>
<body class="text-center">
    <main class="w-100 m-auto" style="max-width: 400px;">
        <div class="card shadow p-4">
            <h2 class="mb-4">Modificar Datos</h2>

            <form action="/update" method="POST">

                <input type="hidden" name="id" value="<%= user.id %>">
                
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="name" name="name" value="<%= user.nombre %>" required>
                    <label for="name">Nombre completo</label>
                </div>

                <div class="form-floating mb-4">
                    <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>" required>
                    <label for="email">Correo electrónico</label>
                </div>
                
                <button class="btn btn-warning w-100 py-2 mb-2" type="submit">Guardar Cambios</button>
                <a href="/" class="btn btn-secondary w-100 py-2">Cancelar</a>
            </form>
        </div>
    </main>
</body>
</html>